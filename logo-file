import * as React from "react";

type GetStartedButtonProps = {
  text: string;
  onClick?: () => void;
  className?: string;
};

type ImageProps = {
  src: string;
  alt: string;
  className?: string;
};

function OnboardingImage({ src, alt, className }: ImageProps): JSX.Element {
  return (
    <img
      loading="lazy"
      src={src}
      alt={alt}
      className={`object-cover absolute inset-0 size-full ${className || ""}`}
    />
  );
}

function GetStartedButton({ text, onClick, className }: GetStartedButtonProps): JSX.Element {
  return (
    <button
      onClick={onClick}
      className={`relative px-14 py-4 max-w-full bg-pink-700 rounded-lg shadow-[0px_4px_4px_rgba(0,0,0,0.25)] w-[215px] text-xl font-bold tracking-tight text-orange-100 hover:bg-pink-800 focus:outline-none focus:ring-2 focus:ring-pink-500 focus:ring-offset-2 transition-colors ${className || ""}`}
      aria-label={text}
    >
      {text}
    </button>
  );
}

